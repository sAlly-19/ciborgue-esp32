# ============================================================================
# Configurações do Robô Ciborgue (Provisionamento Automático na NVS do ESP32)
# ============================================================================

# 1. Credenciais do Wi-Fi (Serão gravadas na memória Flash NVS do ESP32-S3)
WIFI_SSID=seu_wifi_2.4ghz_aqui
WIFI_PASSWORD=sua_senha_wifi_aqui

# 2. Chave da API do Google Gemini (Obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# 3. Cidade padrão para previsão do tempo (Open-Meteo via Wi-Fi do ESP32)
DEFAULT_CITY=Sao Paulo

# 4. Porta Serial (Deixe AUTO para detectar o ESP32-S3 automaticamente ou ex: COM4)
SERIAL_PORT=AUTO
BAUD_RATE=115200

# 5. Palavra de ativação por voz (Wake Word)
WAKE_WORD=ciborgue
