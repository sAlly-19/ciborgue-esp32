# Configurações do Robô Ciborgue

# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Porta serial conectada ao ESP32-S3 (ex: COM4 no Windows ou /dev/ttyUSB0 no Linux)
SERIAL_PORT=COM4
BAUD_RATE=115200

# Palavra de ativação (Wake Word)
WAKE_WORD=ciborgue
